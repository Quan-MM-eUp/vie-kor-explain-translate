          }
        },
        {
          "speaker": "M",
          "ja": "初めてですね。じゃ、ここに住所とお名前を書いてください。",
          "meaning": {
            "vi": "Lần đầu à, viết nơi ở và tên vào đây"
          }
        },
        {
          "speaker": "F",
          "ja": "はい。",
          "meaning": {
            "vi": "Vâng"
          }
        },
        {
          "speaker": "M",
          "ja": "一度に10冊で、2週間借りられます。",
          "meaning": {
            "vi": "1 lần thì có thể mượn 10 cuốn trong 2 tuần"
          }
        },
        {
          "speaker": "F",
          "ja": "そうですか。10冊で…",
          "meaning": {
            "vi": "Thế á, 10 cuốn..."
          }
        },
        {
          "speaker": "M",
          "ja": "2週間です。じゃ、すみません、その紙を。",
          "meaning": {
            "vi": "2 tuần, thế thì đưa tờ giấy đây"
          }
        },
        {
          "speaker": "F",
          "ja": "はい。",
          "meaning": {
            "vi": "Vâng"
          }
        },
        {
          "speaker": "M",
          "ja": "あれ､この町にお住まいではないですね｡",
          "meaning": {
            "vi": "Ơ, không phải sống ở khu này à"
          }
        },
        {
          "speaker": "F",
          "ja": "ええ。",
          "meaning": {
            "vi": "Vâng"
          }
        },
        {
          "speaker": "M",
          "ja": "お勤めは。",
          "meaning": {
            "vi": "Thế chỗ làm?"
          }
        },
        {
          "speaker": "F",
          "ja": "勤めも違うんですが。",
          "meaning": {
