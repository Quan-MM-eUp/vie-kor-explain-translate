  "$defs": {
    "T": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vi": {
          "type": "string",
          "description": "Văn bản cần dịch. Từ/cụm tiếng Nhật không tách ra được thì bọc trong ⟪ ⟫, ví dụ: ⟪もできない⟫ mang nghĩa … Dấu { } (nếu có) đánh dấu phần gạch chân, bản dịch phải giữ đúng 1 cặp { } quanh phần tương ứng."
        }
      },
      "required": [
        "vi"
      ],
      "description": "Trường cần dịch. Bản dịch thêm khóa ngôn ngữ cùng cấp: ko, zh_tw …"
    },
    "Sentence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ja": {
          "type": "string",
          "description": "Tiếng Nhật – KHÔNG dịch. Phần gạch chân/bôi đậm trong đề đặt trong { }, vd: 田中さんは{単なる}友人です。 Tối đa 1 cặp { }."
        },
        "reading": {
          "type": [
            "string",
            "null"
          ],
          "description": "Cách đọc – KHÔNG dịch. Nếu ja có { } thì đặt { } quanh cách đọc tương ứng, vd: たなかさんは{たんなる}ゆうじんです。"
        },
        "meaning": {
          "anyOf": [
            {
              "$ref": "#/$defs/T"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ja",
        "reading",
        "meaning"
      ],
      "description": "Một câu tiếng Nhật + cách đọc + nghĩa. Quy tắc gạch chân: nếu ja có { } thì reading và meaning cũng phải có đúng 1 cặp { } bao phần tương ứng (vd meaning.vi: 'Anh Tanaka chỉ là một người bạn {đơn thuần}.'). Khi dịch, đặt { } quanh từ tương ứng trong bản dịch."
    },
    "Correct": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "option_ja": {
          "type": "string",
          "description": "Tiếng Nhật – KHÔNG dịch, copy nguyên văn"
        },
        "full_sentence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sentence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "index",
        "option_ja",
        "full_sentence"
      ],
      "description": "Lựa chọn đúng (+ câu hoàn chỉnh nếu dạng bài có)"
    },
    "Line": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "speaker": {
          "type": [
            "string",
            "null"
          ],
          "description": "M / F / tên – giữ nguyên"
        },
        "ja": {
          "type": [
            "string",
            "null"
          ],
          "description": "Tiếng Nhật – KHÔNG dịch, copy nguyên văn"
        },
        "meaning": {
          "anyOf": [
            {
              "$ref": "#/$defs/T"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "speaker",
        "ja",
        "meaning"
      ],
      "description": "Một lượt thoại / một câu trong bài đọc"
    },
    "Quote": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ja": {
          "type": "string",
          "description": "Tiếng Nhật – KHÔNG dịch, copy nguyên văn"
        },
        "meaning": {
          "anyOf": [
            {
              "$ref": "#/$defs/T"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ja",
        "meaning"
      ],
      "description": "Câu trích dẫn từ đoạn văn/script"
