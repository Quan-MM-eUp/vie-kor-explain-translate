{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "reading_listening.v1"
      ]
    },
    "question_id": {
      "type": "integer"
    },
    "cau_con": {
      "type": "integer"
    },
    "full_translation": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": [
              "string",
              "null"
            ],
            "description": "A / B / null"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/Line"
            }
          }
        },
        "required": [
          "label",
          "lines"
        ]
      },
      "description": "BẢN DỊCH ĐẦY ĐỦ (hoặc lời thoại) – có thể nằm riêng trên admin"
    },
    "summary": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "heading": {
            "anyOf": [
              {
                "$ref": "#/$defs/T"
              },
              {
                "type": "null"
              }
            ]
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/T"
            }
          }
        },
        "required": [
          "heading",
          "points"
        ]
      },
      "description": "TÓM TẮT"
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ja": {
          "type": [
            "string",
            "null"
          ],
          "description": "Tiếng Nhật – KHÔNG dịch, copy nguyên văn"
        },
        "meaning": {
          "anyOf": [
            {
              "$ref": "#/$defs/T"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ja",
        "meaning"
      ]
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "option_ja": {
            "type": "string",
            "description": "Tiếng Nhật – KHÔNG dịch, copy nguyên văn"
          },
          "reading": {
            "type": [
              "string",
              "null"
            ],
            "description": "Cách đọc hiragana – KHÔNG dịch"
