{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "listening_response.v1",
  "description": "Lời giải dạng 19 – Nghe hiểu diễn đạt (発話表現) (dùng chung được cho dạng 20 – Trả lời nhanh). Đề nghe: một câu tình huống tiếng Nhật ('… 何と言いますか') + 3 câu nói; chọn câu nói phù hợp. Lời giải gốc: dịch tình huống + 3 dòng nghĩa → ### → mỗi lựa chọn: 'i. <câu Nhật>' + 'Nghĩa: …' + '→ ĐÚNG/SAI.' + phân tích. Dạng 19: prompt.utterance.ja do Python điền từ transcript; prompt.situation = null, prompt.analysis = [], mọi reading = null, correct.full_sentence = null.",
  "x-dang-bai": [
    "trả lời nhanh",
    "nghe hiểu diễn đạt"
  ],
  "x-phien-ban": "listening_response.v1 (dạng 19 – dựng 2026-10-08, + reference_raw theo quy tắc THAM KHẢO 2026-10-07)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "enum": [
        "listening_response.v1"
      ]
    },
    "question_id": {
      "type": "integer"
    },
    "cau_con": {
      "type": "integer"
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "situation": {
          "anyOf": [
            {
              "$ref": "#/$defs/T"
            },
            {
              "type": "null"
            }
          ]
        },
        "utterance": {
          "$ref": "#/$defs/Sentence"
        },
        "analysis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/T"
          }
        }
      },
      "required": [
        "situation",
        "utterance",
        "analysis"
      ]
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "sentence": {
            "$ref": "#/$defs/Sentence"
          },
          "is_correct": {
            "type": "boolean"
          },
          "analysis": {
            "anyOf": [
              {
                "$ref": "#/$defs/T"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "index",
          "sentence",
          "is_correct",
          "analysis"
        ]
      }
    },
    "correct": {
      "$ref": "#/$defs/Correct"
    },
    "reference_raw": {
      "type": [
        "string",
        "null"
      ],
      "x-python-dien": true,
      "description": "Phần THÔNG TIN THAM KHẢO của lời giải gốc, chép NGUYÊN VĂN (văn bản đã chuẩn hóa, bỏ nhãn tiêu đề) – Python tự điền, GPT không sinh; không kiểm tra, không sửa, không dịch. Bản gốc không có thì null."
    }
  },
  "required": [
    "schema",
    "question_id",
    "cau_con",
    "prompt",
    "options",
    "correct",
    "reference_raw"
  ],
  "$defs": {
    "T": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vi": {
          "type": "string",
          "description": "Văn bản cần dịch. Từ/cụm tiếng Nhật không tách ra được thì bọc trong ⟪ ⟫, ví dụ: ⟪もできない⟫ mang nghĩa … Dấu { } (nếu có) đánh dấu phần gạch chân, bản dịch phải giữ đúng 1 cặp { } quanh phần tương ứng."
        }
      },
      "required": [
        "vi"
      ],
      "description": "Trường cần dịch. Bản dịch thêm khóa ngôn ngữ cùng cấp: ko, zh_tw …"
    },
    "Sentence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ja": {
          "type": "string",
          "description": "Tiếng Nhật – KHÔNG dịch. Phần gạch chân/bôi đậm trong đề đặt trong { }, vd: 田中さんは{単なる}友人です。 Tối đa 1 cặp { }."
        },
        "reading": {
          "type": [
            "string",
            "null"
          ],
          "description": "Cách đọc – KHÔNG dịch. Nếu ja có { } thì đặt { } quanh cách đọc tương ứng, vd: たなかさんは{たんなる}ゆうじんです。"
        },
        "meaning": {
          "anyOf": [
            {
              "$ref": "#/$defs/T"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ja",
        "reading",
        "meaning"
      ],
      "description": "Một câu tiếng Nhật + cách đọc + nghĩa. Quy tắc gạch chân: nếu ja có { } thì reading và meaning cũng phải có đúng 1 cặp { } bao phần tương ứng (vd meaning.vi: 'Anh Tanaka chỉ là một người bạn {đơn thuần}.'). Khi dịch, đặt { } quanh từ tương ứng trong bản dịch."
    },
    "Correct": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "option_ja": {
          "type": "string",
          "description": "Tiếng Nhật – KHÔNG dịch, copy nguyên văn"
        },
        "full_sentence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Sentence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "index",
        "option_ja",
        "full_sentence"
      ],
      "description": "Lựa chọn đúng (+ câu hoàn chỉnh nếu dạng bài có)"
    },
    "Term": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ja": {
          "type": "string",
          "description": "Tiếng Nhật – KHÔNG dịch, copy nguyên văn"
        },
        "reading": {
          "type": [
            "string",
            "null"
          ],
          "description": "Cách đọc hiragana – KHÔNG dịch"
        },
        "meaning": {
          "anyOf": [
            {
              "$ref": "#/$defs/T"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "anyOf": [
            {
              "$ref": "#/$defs/T"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ja",
        "reading",
        "meaning",
        "note"
      ],
      "description": "Từ/cụm tham khảo, ví dụ"
    },
    "Line": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "speaker": {
          "type": [
            "string",
            "null"
          ],
          "description": "M / F / tên – giữ nguyên"
        },
        "ja": {
          "type": [
            "string",
            "null"
          ],
          "description": "Tiếng Nhật – KHÔNG dịch, copy nguyên văn"
        },
        "meaning": {
          "anyOf": [
            {
              "$ref": "#/$defs/T"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "speaker",
        "ja",
        "meaning"
      ],
      "description": "Một lượt thoại / một câu trong bài đọc"
    },
    "Quote": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ja": {
          "type": "string",
          "description": "Tiếng Nhật – KHÔNG dịch, copy nguyên văn"
        },
        "meaning": {
          "anyOf": [
            {
              "$ref": "#/$defs/T"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ja",
        "meaning"
      ],
      "description": "Câu trích dẫn từ đoạn văn/script"
    }
  }
}