              "x-python-dien": true,
              "description": "Câu nói tiếng Nhật – Python tách từ SCRIPT (cột transcript_vi), bỏ nhãn người nói. Tác tử TẠO KHÔNG sinh trường này."
            },
            "reading": {
              "type": "null",
              "x-python-dien": true,
              "description": "Luôn null – lời giải không có dòng cách đọc câu nói. Python điền."
            },
            "meaning": {
              "anyOf": [
                {
                  "$ref": "#/$defs/T"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Dòng dịch câu nói (trước ###), KHÔNG chép nhãn người nói (Nam: / Nữ: / F: …). Lời giải không có → null."
            }
          },
          "required": [
            "ja",
            "reading",
            "meaning"
          ],
          "description": "Câu nói (lượt thoại thứ nhất) mà người học phải đáp lại."
        },
